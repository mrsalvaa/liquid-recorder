<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_idle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_record"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/widget_record_button"
            android:contentDescription="@string/tile_record"
            android:padding="15dp"
            android:src="@drawable/ic_notification" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_last"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text2"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/widget_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFE5484D"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_marker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/marker"
            android:padding="13dp"
            android:src="@drawable/ic_notif_marker"
            android:tint="@color/widget_icon" />

        <ImageView
            android:id="@+id/widget_pause"
            android:contentDescription="@string/pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button"
            android:padding="13dp"
            android:src="@drawable/ic_notif_pause"
            android:tint="@color/widget_icon" />

        <ImageView
            android:id="@+id/widget_stop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_record_button"
            android:contentDescription="@string/stop"
            android:padding="15dp"
            android:src="@drawable/ic_notif_stop" />
    </LinearLayout>
</FrameLayout>
