<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- El micrófono: se pide la primera vez que se toca Grabar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Seguir grabando con la pantalla apagada o la app cerrada (servicio en primer plano de tipo
        micrófono) y reproducir en segundo plano (tipo reproducción de medios). La notificación se
        pide junto con el micrófono; si se niega, se graba igual sin notificación visible.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Tareas largas (limpiar ruido, exportar) con su notificación de avance, para que Android no
        las corte si se sale de la app: procesamiento de medios en Android 15, sincronización en 14.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Que el procesador no se duerma a mitad de una grabación o reproducción con la pantalla apagada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Usar un micrófono Bluetooth (hay que pedirle al sistema que lo active). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Sin red: nada sale del teléfono. Por si alguna biblioteca los agregara, se quitan del
        manifest final de forma explícita.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
        Fuera lo que agregan las librerías y la app no usa: el permiso interno de androidx.core para
        receptores dinámicos, androidx.startup (emoji2 puede pedir fuentes a Google Play Services) y
        el receptor de profileinstaller.
    -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- Sin backup ni transferencia a otro dispositivo (ver data_extraction_rules). -->
    <application
        android:name=".RecorderApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiquidRecorder">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!--
            "Abrir con" para audio y video (del video solo se reproduce el sonido). Lo que llega es
            entrada no confiable: solo se lee con el permiso temporal que da la otra app.
        -->
        <activity
            android:name=".OpenActivity"
            android:exported="true"
            android:label="@string/open_with_label"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- Para compartir grabaciones: sin exportar y solo con permisos temporales por URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".service.JobService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />

        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Ajuste rápido "Grabar". Solo el sistema puede enlazarlo. -->
        <service
            android:name=".service.RecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_record"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".widget.RecordWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/record_widget_info" />
        </receiver>

        <!-- Un alias por ícono de la app: solo uno está activo (ver util/AppIcons.kt). -->
        <activity-alias
            android:name=".IconLiquid"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconMaterial"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_material"
            android:roundIcon="@mipmap/ic_launcher_material"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconSamsung"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_samsung"
            android:roundIcon="@mipmap/ic_launcher_samsung"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconIphone"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_iphone"
            android:roundIcon="@mipmap/ic_launcher_iphone"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
